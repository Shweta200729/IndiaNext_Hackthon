# Differential Privacy
# DP is disabled by default — MLP weight norms (~300-400) are much larger than
# DP_CLIP_NORM and enabling DP with a low clip norm destroys information → nan loss.
# Re-enable only after tuning DP_CLIP_NORM to match your model's weight scale.
DP_ENABLED=false
DP_CLIP_NORM=500.0
DP_NOISE_MULT=0.01

# ── Federated Learning Settings ──────────────────────────────
DATASET_NAME=
DATASET_ROOT=./data
NUM_CLIENTS=5
LOCAL_EPOCHS=1
BATCH_SIZE=32
LEARNING_RATE=0.01
OPTIMIZER=sgd
MIN_AGGREGATE_SIZE=1
MODEL_HIDDEN_DIMS=256,128
DEVICE=cpu
TEST_SPLIT_RATIO=0.2
NORM_THRESHOLD=1000.0
DISTANCE_THRESHOLD=500.0
TRIM_RATIO=0.1
BG_TRAIN_EPOCHS=3